# RTL-Sentinel 本地配置模板
#
# 用法：把本文件复制为以下任一名字，填入真实值即可。
#   ① 项目目录下的 rtl-sentinel.env
#   ② 项目目录下的 .env
#   ③ 用户目录下的 ~/.rtl-sentinel.env   ← 推荐（与项目分离，不会被误提交）
#
# 这三个文件名都已写入 .gitignore。
# 另外：已存在的系统环境变量优先级更高，配置文件不会覆盖它们。
#
# ---------------------------------------------------------------
# DeepSeek 示例（当前使用的配置）
# ---------------------------------------------------------------
RTL_SENTINEL_API_KEY=sk-在这里填你的key
RTL_SENTINEL_BASE_URL=https://api.deepseek.com/v1
RTL_SENTINEL_MODEL=deepseek-chat

# ---------------------------------------------------------------
# 其他 OpenAI 兼容后端（按需替换上面三行）
# ---------------------------------------------------------------
# 本地 Ollama（需先 ollama pull 一个 coder 模型）
# RTL_SENTINEL_BASE_URL=http://localhost:11434/v1
# RTL_SENTINEL_MODEL=qwen2.5-coder
# RTL_SENTINEL_API_KEY=ollama          # 本地服务不校验，随便填非空值
#
# 通义千问
# RTL_SENTINEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RTL_SENTINEL_MODEL=qwen-plus
#
# 智谱 GLM
# RTL_SENTINEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# RTL_SENTINEL_MODEL=glm-4-plus
